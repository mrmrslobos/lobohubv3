# Neon Postgres connection string (use the pooled connection string — the one
# with "-pooler" in the hostname — since Vercel functions are serverless).
# Get this from the Neon dashboard: Project -> Connection Details.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Used server-side only (api/guidance.ts and the local ingestion script) —
# never shipped to the browser. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Shared secret required to create a new account (api/auth/signup.ts).
# Give this to the elders you want using the app; without it, sign-up is
# disabled entirely rather than defaulting to open.
SIGNUP_INVITE_CODE=choose-a-passphrase
